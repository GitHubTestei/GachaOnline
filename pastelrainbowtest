while true do
    -- Define a table of pastel rainbow colors to cycle through
    local colors = {
        {["R"]=1, ["G"]=0.8, ["B"]=0.8},     -- Light Pink
        {["R"]=1, ["G"]=0.9, ["B"]=0.6},     -- Peach
        {["R"]=1, ["G"]=1, ["B"]=0.6},       -- Light Yellow
        {["R"]=0.8, ["G"]=1, ["B"]=0.8},     -- Light Green
        {["R"]=0.6, ["G"]=1, ["B"]=1},       -- Light Cyan
        {["R"]=0.6, ["G"]=0.8, ["B"]=1},     -- Light Blue
        {["R"]=0.8, ["G"]=0.6, ["B"]=1},     -- Light Purple
        {["R"]=1, ["G"]=0.8, ["B"]=1}        -- Light Lavender
    }

    -- Function to change the color of the shirt
    local function changeShirtColors()
        local replicatedStorage = game:GetService("ReplicatedStorage")
        local serverUpdateColor = replicatedStorage:WaitForChild("ServerUpdateColor")  -- This should be the RemoteEvent for changing shirt color

        local index = 1  -- Start at the first color in the list
        while true do
            local color = colors[index]
            local args = {[1] = "Shirtp", [2] = color}  -- Change to "Shirtp" for shirt
            serverUpdateColor:FireServer(unpack(args))
            
            index = index + 1
            if index > #colors then
                index = 1  -- Reset to the first color if the end of the list is reached
            end
            
            wait(0.5)  -- Wait for 0.5 seconds before changing to the next color
        end
    end

    -- Run the color change function
    changeShirtColors()
end
